<?xml version='1.0' encoding='utf-8'?>
<widget id="com.yourcompany.arenafight" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
 xmlns:android="http://schemas.android.com/apk/res/android">
    <name>ArenaFight</name>
    <description>ArenaFight – A Cordova + Ext JS mobile game</description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>

    <content src="index.html" />

    <!-- Allow all external URLs for plugins like FileTransfer -->
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- Permissions for Android -->
    <platform name="android">
        <!-- Required permissions -->
        <edit-config file="AndroidManifest.xml" mode="merge" target="/manifest/uses-permission">
            <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
            <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
            <uses-permission android:name="android.permission.INTERNET" />
        </edit-config>

        <!-- Splash Screen -->
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/splash/android/splash-icon.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#000000" />
        <preference name="AndroidWindowSplashScreenDuration" value="3000" />
        <preference name="ShowSplashScreenSpinner" value="false" />

        <!-- Icons -->
        <icon density="mdpi" src="resources/icon/android/icon-mdpi.png" />
        <icon density="hdpi" src="resources/icon/android/icon-hdpi.png" />
        <icon density="xhdpi" src="resources/icon/android/icon-xhdpi.png" />
        <icon density="xxhdpi" src="resources/icon/android/icon-xxhdpi.png" />
        <icon density="xxxhdpi" src="resources/icon/android/icon-xxxhdpi.png" />
    </platform>
</widget>
